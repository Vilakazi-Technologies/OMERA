# Omera origin — exact match enforced on state-changing API routes
APP_ORIGIN=http://127.0.0.1:3000

# Demo mode — leave false outside explicit local demos
OMERA_DEMO_MODE=false

# Xavani — preferred chat runtime (server only). If unset, OpenRouter is used.
XAVANI_BASE_URL=https://xavani.example/
XAVANI_API_KEY=
XAVANI_MODEL=omera

# OpenRouter — interim chat when Xavani is not configured (server only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Lelapa — voice transcription (server only)
LELAPA_API_KEY=

# Supabase — Omera persistence (project: meeting-pro-web / your Omera project)
# URL: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — public client values (safe for browser use, no secrets here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
