# Omera origin — exact match enforced on state-changing API routes
APP_ORIGIN=http://127.0.0.1:3000

# Demo mode — leave false outside explicit local demos
OMERA_DEMO_MODE=false

# Xavani — preferred chat runtime (server only). If unset, OpenRouter is used.
XAVANI_BASE_URL=https://xavani.example/
XAVANI_API_KEY=
XAVANI_MODEL=omera

# OpenRouter — interim chat when Xavani is not configured (server only)
OPENROUTER_API_KEY=
# Prefer a fast model for demos (e.g. Gemini Flash Lite free). Nemotron free is slower.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_TOKENS=1600
# Comma-separated OpenRouter fallbacks when the primary model is busy (optional)
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001
# Per-user chat requests per account (Supabase); default 150 in code
# CHAT_QUOTA_LIMIT=150
# Speech-to-text fallback (Whisper via OpenRouter) — reliable demo transcription
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# Lelapa — voice transcription (server only)
LELAPA_API_KEY=

# Google web research for Omera (Programmable Search Engine + API key)
# Create a search engine at https://programmablesearchengine.google.com/ (enable "Search the entire web")
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Optional alias for the engine id (cx)
# GOOGLE_CSE_ID=
# GOOGLE_SEARCH_NUM_RESULTS=6
# Max wait for Google before streaming the reply (ms); default 3500
# GOOGLE_SEARCH_MAX_WAIT_MS=3500

# Clerk — authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/chat

# Supabase — Omera persistence (Postgres + storage; not used for auth)
# URL: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
